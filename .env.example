# ─── ALEX — Personal AI Assistant ───
# Copy this file to .env and fill in your values.
# Every variable config.py reads is listed here; all have defaults except the API keys.

# ─── Assistant Identity ───────────────────────────────────────────────────────
ASSISTANT_NAME=Alex
WAKE_WORD=hey alex

# ─── Speech-to-Text (Whisper) ─────────────────────────────────────────────────
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# ─── Audio Input ──────────────────────────────────────────────────────────────
# Leave blank for the system default microphone, or set a device index.
AUDIO_INPUT_DEVICE=
# Amplitude below this counts as silence (lower = more sensitive)
SILENCE_THRESHOLD=0.003

# ─── Text-to-Speech ───────────────────────────────────────────────────────────
# Options: pyttsx3, coqui
TTS_ENGINE=pyttsx3
TTS_RATE=175
TTS_VOLUME=0.9

# ─── AI Brain — LLM Provider ──────────────────────────────────────────────────
# Options: ollama (local, free), gemini (Google), openai, openrouter
LLM_PROVIDER=gemini

# Ollama (local LLM — install from https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Google Gemini API (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Check what your key can actually see before changing this — older ids like
# gemini-2.0-flash are not available on newer keys and fail with a 404.
GEMINI_MODEL=gemini-3.5-flash

# OpenAI (get a key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter — 200+ models, free tier available (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m3:free,google/gemma-4-31b-it:free

# LLM tuning
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
CONTEXT_WINDOW_SIZE=20
LLM_RETRY_COUNT=2
LLM_RETRY_DELAY=0.5

# ─── Agentic Mode ─────────────────────────────────────────────────────────────
# When true, complex multi-step requests go through the Planner + ReAct loop
AGENT_MODE=true
MAX_AGENT_STEPS=10
AGENT_TIMEOUT=120
PARALLEL_STEPS=true
# execute -> reflect rounds per goal; 1 runs the initial plan only
MAX_AGENT_ITERATIONS=3

# ─── Safety ───────────────────────────────────────────────────────────────────
# When true, plans execute CONFIRM-level tools (shell_run, system_power,
# file_delete, process_kill, code_run) WITHOUT asking. Leave false.
AGENT_AUTO_CONFIRM=false
# Seconds a pending web confirmation stays valid before it expires
CONFIRMATION_TIMEOUT=120
# Restrict file_write / file_move / file_copy / file_delete / file_mkdir to
# config.ALLOWED_FILE_PATHS. Reading and listing are never restricted.
ENFORCE_FILE_ALLOWLIST=true

# ─── Wake Word Detection ──────────────────────────────────────────────────────
# Options: whisper (no key needed), porcupine (needs key)
WAKE_WORD_ENGINE=whisper
PORCUPINE_ACCESS_KEY=your_porcupine_key_here

# ─── Integrations ─────────────────────────────────────────────────────────────
# Weather (for the weather_get tool)
OPENWEATHER_API_KEY=your_openweather_key_here

# Email (for the email_send tool)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=true
